# .gitignore
# ignore node_modules and vendor directories
node_modules/
vendor/

# ignore IDE files
.idea/
.vscode/

# ignore logs and cache files
logs/
cache/

# ignore compiled files
*.class
*.o
*.exe

# ignore IDE temporary files
*.tmp
*.swp

# ignore git submodules
.gitmodules

# ignore IDE backup files
*.bak

# ignore IDE project files
*.iml
*.ipr
*.iws